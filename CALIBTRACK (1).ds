				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<p style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\" class=\"zw-paragraph heading0\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">💡 </span><span style=\"font-size: 12pt; font-weight: 600; vertical-align: baseline\" class=\"size\">Creator tip:</span><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\"> Use this sample form to capture data. Below is an example of how it may look.</span></span></span><br /></p><p style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\" class=\"zw-paragraph heading0\"><br /></p><div><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">Feel free to tweak things via the </span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">form builder. Every form submission is recorded in a </span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">r</span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">eport and can be visuali</span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">z</span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">ed.</span></span></span><br /></div><p style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\" class=\"zw-paragraph heading0\"><span class=\"EOP\">&nbsp;</span><br /></p><div><span style=\"background-color: rgba(0, 0, 0, 0)\" class=\"highlight\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\" class=\"size\">Note: If you're capturing sensitive data via a field, take a look at the field's properties to make </span></span></span></span><span style=\"background-color: rgba(0, 0, 0, 0)\" class=\"highlight\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\" class=\"size\">sure </span></span></span></span><span style=\"background-color: rgba(0, 0, 0, 0)\" class=\"highlight\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\" class=\"size\">it</span></span></span></span><span style=\"background-color: rgba(0, 0, 0, 0)\" class=\"highlight\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\" class=\"size\">'s</span></span></span></span><span style=\"background-color: rgba(0, 0, 0, 0)\" class=\"highlight\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\" class=\"size\"> secured.</span></span></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Add_New
