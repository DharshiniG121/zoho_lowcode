\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 4'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Maintenance_Requests'\n\t\tcriteriaString = 'Maintenance_Status != &quot;Completed&quot; &amp;&amp; Maintenance_Status != &quot;Cancelled&quot;'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 3'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Certificate_Expiry_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</column>\n</row>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void checkCalibrationStatus()
                 {
                 	today = zoho.currentdate;
                 	info "Calibration status check executed on: " + today;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Calibration_Record_Submis as "Calibration Record Submission Workflow"
			{
				type =  form
				form = Calibration_Record_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.loginuserid"
							to : "dharshini.g2.2024.cse@rajalakshmi.edu.in"
							subject : "Record Added"
							message : "<div>${zoho.loginuserid} has added a record in form Calibration Record Form<br></div>"
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Calibration_Date != null)
										{
											input.Next_Calibration_Date = input.Calibration_Date.addMonth(6);
										}
						)
					}
				}

			}
			Certificate_Submission_No as "Certificate Submission Notification"
			{
				type =  form
				form = Calibration_Certificate_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "dharshini.g2.2024.cse@rajalakshmi.edu.in"
							subject : "Calibration Certificate Created"
							message : "<div><span>A new calibration certificate has been created in CALIBTRACK. Please check the certificate details in the application.</span> <br></div>"
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Valid_Until <= zoho.currentdate.addDay(7))
										{
											sendmail
											[
												from :zoho.loginuserid
												to :"dharshini.g2.2024.cse@rajalakshmi.edu.in"
												subject :"CALIBTRACK - Certificate Expiry Alert"
												message :"Dear Admin,\n\nA calibration certificate is expiring soon.\n\nCertificate ID: " + input.Certificate_ID + "\nCertificate Number: " + input.Certificate_Number + "\nValid Until: " + input.Valid_Until + "\n\nPlease arrange certificate renewal.\n\nRegards,\nCALIBTRACK System"
											]
										}
						)
					}
				}

			}
			Maintenance_Request_Notif as "Maintenance Request Notification"
			{
				type =  form
				form = Maintenance_Request_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "dharshini.g2.2024.cse@rajalakshmi.edu.in"
							subject : "New Maintenance Request Created"
							message : "<div>A new maintenance request has been submitted in CALIBTRACK. Please open the application to review the request and assign a technician <br></div>"
						)
					}
				}

			}
			Calculate_Next_Calibratio as "Calculate Next Calibration Date"
			{
				type =  form
				form = Calibration_Record_Form

				record event = on add

				on user input of Calibration_Date
				{
					actions 
					{
						custom deluge script
						(
											if(input.Calibration_Date != null)
										{
											input.Next_Calibration_Date = input.Calibration_Date.addMonth(6);
										}
						)
					}
				}

			}
			Failed_Calibration_Alert as "Failed Calibration Alert"
			{
				type =  form
				form = Calibration_Record_Form

				record event = on add

				on success
				{
					actions  (Calibration_Result == "Failed")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "dharshini.g2.2024.cse@rajalakshmi.edu.in"
							subject : "Calibration Failed - Action Required"
							message : "<div><span>A calibration record has failed. Please inspect the equipment</span> <br></div>"
						)
					}
				}

			}
			Equipment_Status_on_Failu as "Equipment Status on Failure"
			{
				type =  form
				form = Calibration_Record_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Calibration_Result == "Failed")
										{
											info "Calibration failed. Equipment requires inspection.";
										}
						)
					}
				}

			}
			Calibration_Schedule_Stat as "Calibration Schedule Status Check"
			{
				type =  form
				form = Calibration_Schedule_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Scheduled_Date < zoho.currentdate)
										{
											input.Schedule_Status = "Overdue";
										}
						)
					}
				}

			}
			Technician_Assignment_Not as "Technician Assignment Notification"
			{
				type =  form
				form = Calibration_Schedule_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "dharshini.g2.2024.cse@rajalakshmi.edu.in"
							subject : "New Calibration Task Assigned"
							message : "<p><span>${Assigned_Technician}Dear Technician,</span><br></p><p><span>A new calibration task has been assigned to you.</span><br></p><p><span>Please log in to CALIBTRACK and check the Calibration Schedule Form for the equipment details and scheduled date.</span><br></p><p><span>Please complete the calibration on time.</span><br></p><p><br></p><div><span>Thank you,</span><br></div><div><span>CALIBTRACK System</span><br></div><p><br></p><div><br></div>"
						)
					}
					actions 
					{
						custom deluge script
						(
											technicianRecord = Technician_Form[ID == input.Assigned_Technician];
										if(technicianRecord.count() > 0)
										{
											technicianEmail = technicianRecord.Email;
											if(technicianEmail != null && technicianEmail != "")
											{
												sendmail
												[
													from :zoho.adminuserid
													to :technicianEmail
													subject :"New Calibration Task Assigned - CALIBTRACK"
													message :"Dear Technician,<br><br>A new calibration task has been assigned to you. Please log in to CALIBTRACK and check your calibration schedule.<br><br>Thank you,<br>CALIBTRACK System"
												]
											}
										}
						)
					}
				}

			}
			Technician_Registration_N as "Technician Registration Notification"
			{
				type =  form
				form = Technician_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "dharshini.g2.2024.cse@rajalakshmi.edu.in"
							subject : "New Technician Registered - CALIBTRACK"
							message : "<p><span>A new technician has registered in CALIBTRACK.</span><br></p><p><span>Please check the Technician Form to view the technician's details.</span><br></p><p></p><div><span>Thank you,</span><br></div><div><span>CALIBTRACK System</span><br></div><p></p><div><br></div>"
						)
					}
				}

			}
			Equipment_Inspection_Fail as "Equipment Inspection Failure Alert"
			{
				type =  form
				form = Equipment_Inspection_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "dharshini.g2.2024.cse@rajalakshmi.edu.in"
							subject : "CALIBTRACK - Inspection Failure Alert"
							message : "<div><span>An equipment inspection has failed. Please review the inspection record and take corrective action</span> <br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Enter_Daily_Calibration_S as "Enter Daily Calibration Status Check"
			{
				type =  schedule
				start = "2026-10-14 18:05:54"
				frequency = daily
				time zone = "UTC"
				on start
				{
					actions 
					{
					on load
					(
						todayDate = zoho.currentdate;
										for each  schedule in Calibration_Schedule_Form
										{
											// OVERDUE CALIBRATION ALERT
											if(schedule.Scheduled_Date < todayDate && schedule.Schedule_Status != "Completed" && schedule.Schedule_Status != "Cancelled")
											{
												sendmail
												[
													from :zoho.loginuserid
													to :"dharshini.g2.2024.cse@rajalakshmi.edu.in"
													subject :"CALIBTRACK - Overdue Calibration Alert"
													message :"Dear CALIBTRACK Admin,\n\nAn overdue calibration schedule has been identified.\n\nSchedule ID: " + schedule.Schedule_ID + "\nEquipment: " + schedule.Equipment + "\nScheduled Date: " + schedule.Scheduled_Date + "\nAssigned Technician: " + schedule.Assigned_Technician + "\n\nPlease arrange the calibration as soon as possible.\n\nRegards,\nCALIBTRACK System"
												]
											}
											// UPCOMING CALIBRATION REMINDER
											if(schedule.Scheduled_Date >= todayDate && schedule.Scheduled_Date <= todayDate.addDay(7) && schedule.Schedule_Status != "Completed" && schedule.Schedule_Status != "Cancelled")
											{
												sendmail
												[
													from :zoho.loginuserid
													to :"dharshini.g2.2024.cse@rajalakshmi.edu.in"
													subject :"CALIBTRACK - Upcoming Calibration Reminder"
													message :"Dear CALIBTRACK Admin,\n\nCalibration is due within 7 days.\n\nSchedule ID: " + schedule.Schedule_ID + "\nEquipment: " + schedule.Equipment + "\nScheduled Date: " + schedule.Scheduled_Date + "\nAssigned Technician: " + schedule.Assigned_Technician + "\n\nPlease prepare for calibration.\n\nRegards,\nCALIBTRACK System"
												]
											}
										}
					)
					}
				}
			}
		}




	}
	share_settings
	{
