			{
				name = "Technician Permission"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Allows technicians to view equipment and calibration records and manage assigned work\n"
				ModulePermissions
				{
