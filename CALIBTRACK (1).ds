					{
						allFieldsVisible= true 
					}
					Calibration_Record_Form
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							All_Calibration_Records={"View"}
							Calibration_History_Report={"View"}
							Calibration_Status_Report={"View"}
						}
					}
				}
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
					"Laboratory Technician"
					{
						description = "Responsible for equipment calibration, inspection, and maintenance records"
					}
					"Equipment Manager"
					{
						description = "Responsible for equipment records, calibration schedules, certificates, and maintenance requests"
					}
					"Calibration Supervisor"
					{
						description = "Responsible for reviewing calibration results, approving certificates, and monitoring calibration schedules"
					}
				}
			}
	}


