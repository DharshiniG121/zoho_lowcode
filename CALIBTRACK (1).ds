 application "CALIBTRACK"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "UTC"
 	time format = "24-hr"

 	forms
	{
		form Calibration_Certificate_Form
		{
			displayname = "Calibration Certificate Form"
			success message = "Calibration Certificate Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Certificate_ID
			(
    			type = text
				displayname = "Certificate ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certificate_Number
			(
    			type = text
				displayname = "Certificate Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Equipment
			(
				type = picklist	
				values  = Equipment_Form.ID
    			displayformat = [Equipment_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Record_Form
			(
				type = picklist	
				displayname = "Calibration Record Form"
				values  = Calibration_Record_Form.ID
    			displayformat = [Calibration_Record_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Date
			(
    			type = date
				displayname = "Issue Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Valid_From
			(
    			type = date
				displayname = "Valid From"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Valid_Until
			(
    			type = date
				displayname = "Valid Until"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certificate_Status
			(
				type = radiobuttons
				displayname = "Certificate Status"
				maxchar = 100
				values = {"Valid","Expiring Soon","Expired","Suspended"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certificate_File
			(
    			type = upload file
				displayname = "Certificate File"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Calibration_Record_Form
		{
			displayname = "Calibration Record Form"
			success message = "Calibration Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Calibration_Record_ID
			(
    			type = autonumber
				displayname = "Calibration Record ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Equipment
			(
				type = picklist	
				values  = Equipment_Form.ID
    			displayformat = [Equipment_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Date
			(
    			type = date
				displayname = "Calibration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Technician
			(
				type = picklist	
				values  = Technician_Form.ID
    			displayformat = [Technician_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Method
			(
				type = picklist
				displayname = "Calibration Method"
				maxchar = 100
				values = {"Routine Calibration","Recalibration","Initial Calibration","Post-Repair Calibration"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Result
			(
				type = radiobuttons
				displayname = "Calibration Result"
				maxchar = 100
				values = {"Passed","Failed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Overall_Remarks
			(
    			type = textarea
				displayname = "Overall Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Next_Calibration_Date
			(
    			type = date
				displayname = "Next Calibration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Parameters
			(
				type = grid
				displayname = "Calibration Parameters"
				Parameter_Name
				(
    				type = text
					displayname = "Parameter Name"
					width = medium
				)
				Standard_Value
				(
					type = decimal
					displayname = "Standard Value"
					width = medium
				)
				Actual_Value
				(
					type = decimal
					displayname = "Actual Value"
					width = medium
				)
				Tolerance
				(
					type = decimal
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Unit
			(
				type = picklist
				maxchar = 100
				values = {"kg","g","mg","°C","°F","mL","L"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Result
			(
				type = radiobuttons
				maxchar = 100
				values = {"Pass","Fail"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = text
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
